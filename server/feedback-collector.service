[Unit]
Description=Node.js feedback collector service
After=network.target

[Service]
ExecStart=/usr/bin/env node /opt/feedback-collector.js
Restart=always
RestartSec=5
Environment=PORT=8090
Environment=READ_PASSWORD=change_this_to_a_secure_password
User=server
Group=server
WorkingDirectory=/opt

[Install]
WantedBy=multi-user.target
